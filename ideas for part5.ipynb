    "# For part5, we want to find the frequency of all pairs.\n",
    "## Logic and knowledge of the english language tells us certian pairs of letters, such as wj (random example) have zero frequency whereas others such as ee are more frequent\n",
    "def bigram_frequency(string, first_letter, second_letter):\n",
    "    \n",
    "    pair= str(first_letter) + str(second_letter)\n",
    "    return string.count(pair)\n",
    "\n",
